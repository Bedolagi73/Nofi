<Window x:Class="Nofi.UI.TaskEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задача уведомления" Width="560" Height="720" MinHeight="500" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}" FontFamily="Segoe UI" FontSize="14" Language="ru-RU"
        Loaded="EditorLoaded" Closing="EditorClosing">
    <Grid Margin="24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="EditorTitle" Style="{StaticResource Heading}" FontSize="27" Margin="0,0,0,16" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                        <Label Content="Канал" Target="{Binding ElementName=ChannelInput}" />
                        <ComboBox x:Name="ChannelInput" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectionChanged="ChannelChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <Label Content="Получатель" Target="{Binding ElementName=RecipientInput}" />
                        <TextBox x:Name="RecipientInput" MaxLength="254" />
                        <TextBlock x:Name="RecipientHint" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <Label Content="Текст сообщения" Target="{Binding ElementName=MessageInput}" />
                <TextBox x:Name="MessageInput" MinHeight="94" MaxLength="2000" AcceptsReturn="True"
                         VerticalContentAlignment="Top" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,12" />
                <Label Content="Тип расписания" Target="{Binding ElementName=ScheduleInput}" />
                <ComboBox x:Name="ScheduleInput" DisplayMemberPath="Label" SelectedValuePath="Value"
                          Margin="0,0,0,10" SelectionChanged="ScheduleChanged" />
                <Label Content="Часовой пояс" Target="{Binding ElementName=TimeZoneInput}" />
                <ComboBox x:Name="TimeZoneInput" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                          Margin="0,0,0,10" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="TimePanel" Margin="0,0,10,0">
                        <Label Content="Время (ЧЧ:ММ)" Target="{Binding ElementName=TimeInput}" />
                        <TextBox x:Name="TimeInput" MaxLength="5" />
                    </StackPanel>
                    <StackPanel x:Name="DatePanel" Grid.Column="1">
                        <Label Content="Дата" Target="{Binding ElementName=DateInput}" />
                        <DatePicker x:Name="DateInput" />
                    </StackPanel>
                </Grid>
                <StackPanel x:Name="DaysPanel" Margin="0,0,0,8">
                    <Label Content="Дни недели" Target="{Binding ElementName=DaysInput}" />
                    <WrapPanel x:Name="DaysInput" />
                </StackPanel>
                <StackPanel x:Name="IntervalPanel" Margin="0,0,0,8">
                    <Label Content="Интервал, минут" Target="{Binding ElementName=IntervalInput}" />
                    <TextBox x:Name="IntervalInput" MaxLength="6" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="EditorError" Grid.Row="2" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"
                   Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton" Content="Отмена" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="SaveButton" Content="Сохранить" Style="{StaticResource PrimaryButton}"
                    IsDefault="True" Click="SaveClicked" />
        </StackPanel>
    </Grid>
</Window>
